# Configuración de MiReceta Cerca.
# Copie este archivo como ".env" (en la misma carpeta) y cambie lo que necesite.
# NINGUNA variable es obligatoria: si una línea está vacía o comentada, se usa el valor por defecto.

# Base de datos SQLite. Ruta relativa = desde la carpeta del proyecto.
MIRECETA_DB=data/mireceta.db

# Zona horaria para horarios de droguerías, avisos y vencimientos.
MIRECETA_TZ=America/Bogota

# Días que dura la sesión del paciente (larga, para no pedir el PIN a cada rato).
MIRECETA_SESSION_DAYS=30

# Horas que dura la sesión del personal de la droguería (un turno).
MIRECETA_STAFF_SESSION_HOURS=12

# 1 = las cookies de sesión solo viajan por HTTPS. Póngalo en 1 al publicar en internet.
# Déjelo en 0 en su computador (http://localhost), o no podrá ingresar.
MIRECETA_COOKIE_SECURE=0

# Horas que se guarda una reserva antes de vencer y devolver las cajas al inventario.
MIRECETA_HOLD_HOURS=24

# Minutos estimados de preparación que se le muestran al paciente.
MIRECETA_PREP_MINUTES=15

# Tiempo real: cada cuántos segundos se revisan cambios hechos desde otro proceso (la terminal).
MIRECETA_LIVE_POLL=1.0

# Tiempo real: segundos que dura cada conexión en vivo antes de que el navegador reconecte solo.
MIRECETA_LIVE_STREAM_SECONDS=300
