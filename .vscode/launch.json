{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiReceta Cerca (servidor)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Reiniciar base con datos de ejemplo",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["reset", "--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
